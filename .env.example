# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Second verrou admin (après connexion compte rôle admin) — code à saisir sur /admin/unlock
# Après avoir quitté /admin, le code est redemandé au bout d’1 minute (cookie, pas de cron).
ADMIN_GATE_PASSWORD=choisissez_un_code_fort
# Secret pour signer le cookie (recommandé en prod ; sinon fallback sur SUPABASE_SERVICE_ROLE_KEY)
# ADMIN_GATE_SECRET=long_random_string

# Médias admin (photos + MP4) : buckets room-images & table-images — supabase/storage-hotel-media.sql

# Stripe (désactivé pour l'instant — réactiver avec PAYMENT_MODE=stripe)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Mode de paiement chambres : on_site (défaut) | stripe
PAYMENT_MODE=on_site
NEXT_PUBLIC_PAYMENT_MODE=on_site

# Email hôtel (affiché sur le site + rappel admin pour les emails manuels invités)
NEXT_PUBLIC_CONTACT_EMAIL=contact@votre-domaine.com

# Alertes admin uniquement (nouvelles demandes de réservation — pas les confirmations clients)
# ADMIN_NOTIFICATION_EMAIL=reservations@votre-domaine.com

# Optionnel — envoi automatique par le site (désactivé pour les clients invités)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Bon Accueil Hotel <reservations@votre-domaine.com>

NEXT_PUBLIC_APP_URL=https://votre-domaine.com
NEXT_PUBLIC_CONTACT_PHONE=+50937471711
NEXT_PUBLIC_HOTEL_ADDRESS=7CPG+PQ3, Rte de L'amitié, Arrondissement de Jacmel 9110
# Google Maps (optionnel — embed carte ; une URL par défaut est déjà configurée)
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://maps.google.com/maps?q=...
